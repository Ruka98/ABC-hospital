######################################
# Supabase Database (required)
######################################
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@YOUR_PROJECT.supabase.co:5432/postgres?sslmode=require
# (Optional alias) SUPABASE_DB_URL=postgresql://...

######################################
# Supabase Storage (optional but recommended for report uploads)
######################################
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_PUBLIC_API_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
SUPABASE_REPORTS_BUCKET=reports
NEXT_PUBLIC_SUPABASE_REPORTS_BUCKET=reports

######################################
# General
######################################
NODE_ENV=development
