######################################
# Postgres Database (required)
######################################
# Use your Neon **pooled** connection string (Connection Details ➜ Connection Strings ➜ Pooled ➜ psql/node)
# Example: postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
# Optional aliases if you prefer different names
# NEON_DATABASE_URL=...
# SUPABASE_DB_URL=...

######################################
# Supabase Storage (optional; needed only if you want report uploads in Supabase Storage)
######################################
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_PUBLIC_API_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
SUPABASE_REPORTS_BUCKET=reports
NEXT_PUBLIC_SUPABASE_REPORTS_BUCKET=reports

######################################
# General
######################################
NODE_ENV=development
